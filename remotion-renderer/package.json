{
  "name": "vimmer-remotion-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts Timeline out/test-scene.mp4 --props=../fixtures/sample-timeline.json",
    "typecheck": "tsc --noEmit",
    "editor": "vite --config editor/vite.config.ts",
    "editor:build": "vite build --config editor/vite.config.ts",
    "typecheck:editor": "tsc --noEmit -p editor/tsconfig.json",
    "test:motion": "node --experimental-strip-types --test test/motion.test.ts",
    "test:words": "node --experimental-strip-types --test test/word-subtitles.test.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
