{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vimmer Studio",
  "version": "0.1.0",
  "identifier": "com.vimmer.studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../remotion-renderer run editor -- --port 5180 --strictPort",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm --prefix ../remotion-renderer run editor:build",
    "frontendDist": "../../remotion-renderer/editor/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vimmer Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
